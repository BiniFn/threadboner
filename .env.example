# For Supabase, use the Transaction pooler URI as DATABASE_URL (the app uses pg directly).
DATABASE_URL=postgresql://username:password@host/database?sslmode=require
# Optional Supabase database CA certificate (required if your pooler CA isn't in the runtime trust store).
DATABASE_SSL_CA=
# Set to "disable" only for a non-production database without TLS.
DATABASE_SSL=
SESSION_SECRET=replace-with-long-random-string
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_token
# Vercel OIDC: provide the private store ID; VERCEL_OIDC_TOKEN is injected by Vercel.
# Local or legacy fallback: set PRIVATE_BLOB_READ_WRITE_TOKEN instead.
PRIVATE_BLOB_READ_WRITE_TOKEN=
PRIVATE_BLOB_STORE_ID=
PRIVATE_BLOB_WEBHOOK_PUBLIC_KEY=
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=replace-with-strong-password
API_BASE_URL=
TTS_SERVICE_URL=
TTS_SERVICE_TOKEN=
